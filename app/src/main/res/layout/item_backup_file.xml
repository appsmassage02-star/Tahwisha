<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_badge_upcoming"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBackupFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="gam3ya_latest.json"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBackupFileMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="أحدث نسخة احتياطية"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="11sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRestoreThisBackup"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minHeight="48dp"
        android:background="@drawable/bg_button_primary"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="استعادة"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
